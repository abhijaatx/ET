# ──── Amazon Bedrock (uses AWS credentials / instance role) ─
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0
BEDROCK_MIN_INTERVAL_MS=1000
BEDROCK_COOLDOWN_MS=30000

# ──── Database (Docker Compose defaults) ────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myet

# ──── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──── News Sources (at least ONE required) ──────────────────
NEWSAPI_KEY=
GNEWS_KEY=

# ──── Auth ──────────────────────────────────────────────────
NEXTAUTH_SECRET=dev-secret-change-me

# ──── Frontend → API ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ──── Voice Synthesis (optional, for Broadcast feature) ─────
ELEVENLABS_API_KEY=
GROQ_VOICE_API_KEY=

# ──── Misc ──────────────────────────────────────────────────
NODE_OPTIONS=--dns-result-order=ipv4first
