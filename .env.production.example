# Public endpoint.
# Use a real domain for HTTPS, for example: SITE_ADDRESS=news.example.com
# For a temporary HTTP-only test on the instance public IP, use: SITE_ADDRESS=:80
SITE_ADDRESS=news.example.com
PUBLIC_BASE_URL=https://news.example.com
ACME_EMAIL=admin@example.com

# Postgres runs inside docker-compose.prod.yml.
POSTGRES_USER=myet
# Use URL-safe characters only because docker-compose builds DATABASE_URL from this value.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=myet

# API runtime secrets.
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEWSAPI_KEY=
GNEWS_KEY=

# Amazon Bedrock text generation and Titan embeddings use the EC2 instance role.
# No Bedrock API key is needed.
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0
BEDROCK_MIN_INTERVAL_MS=1000
BEDROCK_COOLDOWN_MS=30000
# docker-compose sets API calls to interactive and worker calls to background.
AI_REQUEST_PRIORITY=interactive

# Production ingest behavior.
# docker-compose keeps the worker from polling constantly; the API queues a refresh
# when someone opens the feed, throttled by this cooldown.
INGEST_SCHEDULE_ENABLED=false
INGEST_BOOT_ENABLED=false
INGEST_WATCHDOG_ENABLED=false
INGEST_ON_DEMAND_ENABLED=true
INGEST_ON_DEMAND_COOLDOWN_MS=900000

# Optional voice synthesis for Broadcast.
ELEVENLABS_API_KEY=
GROQ_VOICE_API_KEY=
